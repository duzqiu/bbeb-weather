/**index.wxss**/
.page {
  min-height: 100vh;
  padding: 16rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  background-color: #eef4fb;
  background-image: linear-gradient(
    165deg,
    #cfe2fb 0%,
    #e8f2ff 36%,
    #f7f0ea 72%,
    #fcefe6 100%
  );
  background-attachment: fixed;
}

/* 卡片内的地点行 */
.hero-location {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.place-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.hero-place {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.88);
  transition: color 0.2s ease, opacity 0.2s ease;
}

.hero-place.is-busy {
  color: rgba(0, 0, 0, 0.35);
  opacity: 0.7;
}

.location-action {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #07c160;
}

.action-text {
  font-size: 24rpx;
  color: #07c160;
}

.spinner {
  width: 22rpx;
  height: 22rpx;
  margin-right: 8rpx;
  border: 3rpx solid rgba(7, 193, 96, 0.2);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.location-hint {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.35);
}

/* 今日天气（白底卡片） */
.hero {
  margin-top: 0;
  padding: 36rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background-color: rgba(255, 255, 255, 0.40);
  background-image: linear-gradient(
    140deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.16) 42%,
    rgba(255, 255, 255, 0.08) 62%,
    rgba(255, 255, 255, 0.46) 100%
  );
  -webkit-backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  box-shadow:
    0 10rpx 40rpx rgba(23, 43, 77, 0.12),
    0 1rpx 2rpx rgba(255, 255, 255, 0.65) inset,
    0 -1rpx 2rpx rgba(255, 255, 255, 0.22) inset;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.updated {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 21rpx;
  white-space: nowrap;
  color: rgba(0, 0, 0, 0.35);
}

.hero-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 20rpx;
}


.temp {
  font-size: 132rpx;
  font-weight: 300;
  line-height: 1;
  color: rgba(0, 0, 0, 0.9);
}

.hero-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 12rpx;
}

.hero-icon {
  font-size: 64rpx;
  line-height: 1;
  color: #2f6fd0;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.55);
}

.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.hero-range {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.55);
}

.hero-feel {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.55);
}

.temp-icon-feel {
  width: 24rpx;
  height: 24rpx;
  margin: 0 4rpx 0 0;
}

.temp-icon {
  width: 26rpx;
  height: 26rpx;
  margin: 0 6rpx;
  flex-shrink: 0;
}

.temp-icon-hot {
  margin-left: 0;
  margin-right: 4rpx;
}

/* 空气质量 / 风向风力：与天气指数卡片同款，仅多一个上间距 */
.metric-grid {
  margin-top: 24rpx;
}

/* 区块 */
.section {
  margin-top: 36rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: rgba(0, 0, 0, 0.45);
}

/* 24 小时 */
.hourly {
  white-space: nowrap;
  box-sizing: border-box;
  height: 172rpx;
  padding: 12rpx 8rpx;
  background-color: rgba(255, 255, 255, 0.40);
  background-image: linear-gradient(
    140deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.16) 42%,
    rgba(255, 255, 255, 0.08) 62%,
    rgba(255, 255, 255, 0.46) 100%
  );
  -webkit-backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  box-shadow:
    0 10rpx 40rpx rgba(23, 43, 77, 0.12),
    0 1rpx 2rpx rgba(255, 255, 255, 0.65) inset,
    0 -1rpx 2rpx rgba(255, 255, 255, 0.22) inset;
}

.hour {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  vertical-align: top;
  width: 116rpx;
  height: 148rpx;
}

.hour-time {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.45);
}

.hour-icon {
  margin: 10rpx 0;
  font-size: 36rpx;
  line-height: 1;
  color: rgba(0, 0, 0, 0.62);
}

.hour-temp {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.85);
}

/* 7 天 */
.daily {
  padding: 8rpx 28rpx;
  background-color: rgba(255, 255, 255, 0.40);
  background-image: linear-gradient(
    140deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.16) 42%,
    rgba(255, 255, 255, 0.08) 62%,
    rgba(255, 255, 255, 0.46) 100%
  );
  -webkit-backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  box-shadow:
    0 10rpx 40rpx rgba(23, 43, 77, 0.12),
    0 1rpx 2rpx rgba(255, 255, 255, 0.65) inset,
    0 -1rpx 2rpx rgba(255, 255, 255, 0.22) inset;
}

.day {
  display: flex;
  align-items: center;
  height: 92rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.day:last-child {
  border-bottom: none;
}

.day-date {
  display: flex;
  align-items: flex-end;
  flex-shrink: 0;
  width: 116rpx;
  margin-right: 20rpx;
}

.day-name {
  white-space: nowrap;
  font-size: 26rpx;
  line-height: 1.2;
  color: rgba(0, 0, 0, 0.85);
}

.day-sub {
  margin-left: 6rpx;
  margin-bottom: 1rpx;
  white-space: nowrap;
  font-size: 18rpx;
  line-height: 1.2;
  color: rgba(0, 0, 0, 0.4);
}

.day-icon {
  width: 48rpx;
  margin-right: 10rpx;
  text-align: center;
  font-size: 30rpx;
  line-height: 1;
  color: rgba(0, 0, 0, 0.62);
}

.day-desc {
  width: 92rpx;
  margin-right: 8rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.bar {
  flex: 1;
  margin-right: 12rpx;
}

.bar-track {
  position: relative;
  height: 10rpx;
  border-radius: 6rpx;
  background-color: rgba(0, 0, 0, 0.06);
}

.bar-range {
  position: absolute;
  top: 0;
  height: 10rpx;
  border-radius: 6rpx;
  background-image: linear-gradient(90deg, #7cc6ff 0%, #ffb547 100%);
}

.day-temp {
  width: 112rpx;
  text-align: right;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
}

/* 天气指数 */
.index-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.index-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 26rpx 26rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background-color: rgba(255, 255, 255, 0.40);
  background-image: linear-gradient(
    140deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.16) 42%,
    rgba(255, 255, 255, 0.08) 62%,
    rgba(255, 255, 255, 0.46) 100%
  );
  -webkit-backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 24rpx;
  box-shadow:
    0 10rpx 40rpx rgba(23, 43, 77, 0.12),
    0 1rpx 2rpx rgba(255, 255, 255, 0.65) inset,
    0 -1rpx 2rpx rgba(255, 255, 255, 0.22) inset;
}

.index-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.index-icon {
  margin-right: 10rpx;
  font-size: 30rpx;
  line-height: 1;
}

.index-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}




.index-name {
  font-size: 23rpx;
  color: rgba(0, 0, 0, 0.5);
}

.index-value {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.index-tip {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.4);
}

.data-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 21rpx;
  color: rgba(0, 0, 0, 0.3);
}

/* 骨架屏 */
.sk-card {
  margin-bottom: 24rpx;
  padding: 36rpx;
  background-color: rgba(255, 255, 255, 0.40);
  background-image: linear-gradient(
    140deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.16) 42%,
    rgba(255, 255, 255, 0.08) 62%,
    rgba(255, 255, 255, 0.46) 100%
  );
  -webkit-backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  box-shadow:
    0 10rpx 40rpx rgba(23, 43, 77, 0.12),
    0 1rpx 2rpx rgba(255, 255, 255, 0.65) inset,
    0 -1rpx 2rpx rgba(255, 255, 255, 0.22) inset;
}

.sk {
  border-radius: 10rpx;
  background-image: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.05) 25%,
    rgba(0, 0, 0, 0.1) 37%,
    rgba(0, 0, 0, 0.05) 63%
  );
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}

.sk-bar {
  height: 24rpx;
}

.sk-thin {
  height: 18rpx;
  margin-top: 14rpx;
}

.sk-temp {
  width: 44%;
  height: 128rpx;
  margin-top: 22rpx;
}

.sk-row {
  display: flex;
}

.sk-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sk-block {
  height: 300rpx;
}

.sk-short {
  height: 200rpx;
}

@keyframes sk-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* 指标卡：大图标放右侧空白处 */
.index-card-icon {
  position: relative;
  min-height: 176rpx;
}

.card-icon {
  position: absolute;
  top: 50%;
  right: 10rpx;
  transform: translateY(-50%);
  font-size: 88rpx;
  line-height: 1;
  opacity: 1;
}

.card-icon-img {
  position: absolute;
  top: 50%;
  right: 10rpx;
  transform: translateY(-50%);
  width: 102rpx;
  height: 102rpx;
}


.index-card-icon .index-name {
  padding-right: 128rpx;
  font-size: 24rpx;
}

.index-card-icon .index-value {
  margin-top: 18rpx;
  padding-right: 128rpx;
}


.index-card-icon .index-tip {
  margin-top: 14rpx;
}

/* 大雨等彩色 SVG 图标 */
.hero-icon-img {
  width: 76rpx;
  height: 76rpx;
}

.hour-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin: 8rpx 0;
}

.day-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.sun-card {
  min-height: 218rpx;
}

.sun-body {
  flex: 1;
  display: flex;
  align-items: stretch;
  margin-top: 10rpx;
}

.sun-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.sun-divider {
  width: 1rpx;
  align-self: stretch;
  background-color: rgba(0, 0, 0, 0.08);
}

.sun-icon {
  width: 86rpx;
  height: 86rpx;
  flex-shrink: 0;
}

.sun-time {
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(0, 0, 0, 0.62);
}

/* 湿度：水位浸满整卡 + 环形进度 */
.humidity-card {
  position: relative;
  min-height: 206rpx;
  overflow: hidden;
}

.humidity-water {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  background-image: linear-gradient(
    180deg,
    rgba(163, 216, 242, 0.55) 0%,
    rgba(139, 203, 240, 0.75) 100%
  );
  transition: height 0.5s ease;
}

/* 水面波浪：两个旋转的圆形制造起伏 */
.humidity-wave {
  position: absolute;
  left: 50%;
  top: -404rpx;
  width: 424rpx;
  height: 424rpx;
  margin-left: -212rpx;
  border-radius: 44%;
  background-color: rgba(255, 255, 255, 0.14);
  animation: humidity-wave 7s linear infinite;
}

.wave-b {
  top: -408rpx;
  border-radius: 47%;
  background-color: rgba(255, 255, 255, 0.08);
  animation-duration: 11s;
  animation-direction: reverse;
}

@keyframes humidity-wave {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.humidity-content {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
}

.humidity-left {
  display: flex;
  flex-direction: column;
}

.humidity-title {
  font-size: 23rpx;
  color: rgba(0, 0, 0, 0.5);
}

.humidity-value {
  margin-top: 22rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.05;
  color: rgba(0, 0, 0, 0.88);
}


.humidity-right {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.humidity-gauge {
  position: relative;
  width: 132rpx;
  height: 112rpx;
  overflow: hidden;
}

.humidity-arc {
  position: absolute;
  left: 0;
  top: 0;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  /* 只保留圆弧，圆内透明 */
  -webkit-mask: radial-gradient(
    circle at 50% 50%,
    rgba(0, 0, 0, 0) 0,
    rgba(0, 0, 0, 0) 52rpx,
    #000 52rpx,
    #000 100%
  );
  mask: radial-gradient(
    circle at 50% 50%,
    rgba(0, 0, 0, 0) 0,
    rgba(0, 0, 0, 0) 52rpx,
    #000 52rpx,
    #000 100%
  );
}

.humidity-hole {
  position: absolute;
  left: 0;
  top: 0;
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.humidity-drop {
  width: 44rpx;
  height: 44rpx;
  transform: translateY(-10rpx);
}

.humidity-gauge-label {
  position: absolute;
  left: 0;
  right: 0;
  top: 102rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 20rpx;
  color: rgba(0, 0, 0, 0.5);
}
