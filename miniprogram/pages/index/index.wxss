/**index.wxss**/
.page {
  min-height: 100vh;
  padding: 16rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  background-color: #f5f6f8;
}

/* 卡片内的地点行 */
.hero-location {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.hero-place {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.88);
  transition: color 0.2s ease, opacity 0.2s ease;
}

.hero-place.is-busy {
  color: rgba(0, 0, 0, 0.35);
  opacity: 0.7;
}

.location-action {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #07c160;
}

.action-text {
  font-size: 24rpx;
  color: #07c160;
}

.spinner {
  width: 22rpx;
  height: 22rpx;
  margin-right: 8rpx;
  border: 3rpx solid rgba(7, 193, 96, 0.2);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.location-hint {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.35);
}

/* 今日天气（白底卡片） */
.hero {
  margin-top: 0;
  padding: 36rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background-color: rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: blur(30rpx);
  backdrop-filter: blur(30rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.05);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.updated {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.35);
}

.hero-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 20rpx;
}

.temp {
  font-size: 132rpx;
  font-weight: 300;
  line-height: 1;
  color: rgba(0, 0, 0, 0.9);
}

.hero-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 12rpx;
}

.hero-icon {
  font-size: 64rpx;
  line-height: 1;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.55);
}

.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.hero-range,
.hero-feel {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.55);
}

/* 空气质量 / 风向风力：与天气指数卡片同款，仅多一个上间距 */
.metric-grid {
  margin-top: 24rpx;
}

/* 区块 */
.section {
  margin-top: 36rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: rgba(0, 0, 0, 0.45);
}

/* 24 小时 */
.hourly {
  white-space: nowrap;
  box-sizing: border-box;
  height: 172rpx;
  padding: 12rpx 8rpx;
  background-color: rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: blur(30rpx);
  backdrop-filter: blur(30rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.hour {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  vertical-align: top;
  width: 116rpx;
  height: 148rpx;
}

.hour-time {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.45);
}

.hour-icon {
  margin: 10rpx 0;
  font-size: 36rpx;
  line-height: 1;
}

.hour-temp {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.85);
}

/* 7 天 */
.daily {
  padding: 8rpx 28rpx;
  background-color: rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: blur(30rpx);
  backdrop-filter: blur(30rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.day {
  display: flex;
  align-items: center;
  height: 92rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.day:last-child {
  border-bottom: none;
}

.day-name {
  width: 96rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.85);
}

.day-icon {
  width: 56rpx;
  font-size: 30rpx;
  line-height: 1;
}

.day-desc {
  width: 128rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.bar {
  flex: 1;
  padding: 0 16rpx;
}

.bar-track {
  position: relative;
  height: 10rpx;
  border-radius: 6rpx;
  background-color: rgba(0, 0, 0, 0.06);
}

.bar-range {
  position: absolute;
  top: 0;
  height: 10rpx;
  border-radius: 6rpx;
  background-image: linear-gradient(90deg, #7cc6ff 0%, #ffb547 100%);
}

.day-temp {
  width: 150rpx;
  text-align: right;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
}

/* 天气指数 */
.index-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.index-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 26rpx 26rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background-color: rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: blur(30rpx);
  backdrop-filter: blur(30rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.index-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.index-icon {
  margin-right: 10rpx;
  font-size: 30rpx;
  line-height: 1;
}

.index-name {
  font-size: 23rpx;
  color: rgba(0, 0, 0, 0.5);
}

.index-value {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.index-tip {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.4);
}

.data-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 21rpx;
  color: rgba(0, 0, 0, 0.3);
}

/* 骨架屏 */
.sk-card {
  margin-bottom: 24rpx;
  padding: 36rpx;
  background-color: rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: blur(30rpx);
  backdrop-filter: blur(30rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.sk {
  border-radius: 10rpx;
  background-image: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.05) 25%,
    rgba(0, 0, 0, 0.1) 37%,
    rgba(0, 0, 0, 0.05) 63%
  );
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}

.sk-bar {
  height: 24rpx;
}

.sk-thin {
  height: 18rpx;
  margin-top: 14rpx;
}

.sk-temp {
  width: 44%;
  height: 128rpx;
  margin-top: 22rpx;
}

.sk-row {
  display: flex;
}

.sk-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sk-block {
  height: 300rpx;
}

.sk-short {
  height: 200rpx;
}

@keyframes sk-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* 指标卡：大图标放右侧空白处 */
.index-card-icon {
  position: relative;
  min-height: 164rpx;
}

.card-icon {
  position: absolute;
  top: 50%;
  right: 10rpx;
  transform: translateY(-50%);
  font-size: 88rpx;
  line-height: 1;
  opacity: 1;
}

.index-card-icon .index-name {
  padding-right: 112rpx;
  font-size: 24rpx;
}

.index-card-icon .index-value {
  margin-top: 18rpx;
  padding-right: 112rpx;
}

.index-card-icon .index-tip {
  margin-top: 14rpx;
}
