<!--pages/index/index.wxml-->
<!-- 顶部不做任何蒙层：内容直接展示，只用 padding 避开状态栏 -->
<view class="page {{glassVisible ? 'is-blurred' : ''}}" style="padding-top: {{navTotalHeight - 20}}px;">
  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="sk-hero">
      <view class="sk sk-bar" style="width: 35%;"></view>
      <view class="sk sk-temp"></view>
      <view class="sk sk-bar" style="width: 55%; margin-top: 26rpx;"></view>
    </view>

    <view class="sk-card sk-row">
      <view class="sk-col">
        <view class="sk sk-bar" style="width: 55%;"></view>
        <view class="sk sk-bar sk-thin" style="width: 80%;"></view>
      </view>
      <view class="sk-col">
        <view class="sk sk-bar" style="width: 55%;"></view>
        <view class="sk sk-bar sk-thin" style="width: 80%;"></view>
      </view>
      <view class="sk-col">
        <view class="sk sk-bar" style="width: 55%;"></view>
        <view class="sk sk-bar sk-thin" style="width: 80%;"></view>
      </view>
    </view>

    <view class="sk-card sk-block"></view>
    <view class="sk-card sk-block"></view>
    <view class="sk-card sk-block sk-short"></view>
  </block>

  <block wx:else>
    <!-- 今日天气（地点在卡片内） -->
    <view class="hero">
      <view class="hero-top">
        <view class="hero-location">
          <image class="place-icon" src="/images/icons/location.svg" mode="aspectFit"></image>
          <text class="hero-place {{locating ? 'is-busy' : ''}}">{{place}}</text>
          <view
            class="location-action"
            hover-class="is-pressed"
            hover-stay-time="80"
            bindtap="onLocateTap"
          >
            <view wx:if="{{locating}}" class="spinner"></view>
            <text class="action-text">{{locating ? '定位中' : '重新定位'}}</text>
          </view>
        </view>
        <text class="updated">{{updatedAt}} 更新</text>
      </view>
      <text class="location-hint" wx:if="{{hint}}">{{hint}}</text>

      <view class="hero-main">
        <view class="hero-temp">
          <text class="temp">{{temp}}°</text>
          <image
            class="hero-feel-icon"
            src="/images/icons/temp-now.svg"
            mode="aspectFit"
          ></image>
          <text class="hero-feel-inline">体感 {{feel}}°</text>
        </view>
        <view class="hero-right">
          <image wx:if="{{image}}" class="hero-icon-img" src="{{image}}" mode="aspectFit"></image>
          <text wx:else class="qi hero-icon" style="color: {{color}};">{{glyph}}</text>
          <text class="hero-desc">{{desc}}</text>
        </view>
      </view>

      <view class="hero-bottom">
        <view class="hero-range">
          <image class="temp-icon temp-icon-hot" src="/images/icons/thermometer-hot.svg" mode="aspectFit"></image>
          <text>最高 {{high}}° · </text>
          <image class="temp-icon" src="/images/icons/thermometer.svg" mode="aspectFit"></image>
          <text>最低 {{low}}°</text>
        </view>
      </view>
    </view>

    <!-- 空气质量 / 风向风速 -->
    <view class="index-grid metric-grid">
      <view class="index-card index-card-icon">
        <image wx:if="{{aqiImage}}" class="card-icon-img" src="{{aqiImage}}" mode="aspectFit"></image>
        <text wx:else class="card-icon">{{aqiIcon}}</text>
        <text class="index-name">空气质量</text>
        <text class="index-value">{{aqi}} {{aqiText}}</text>
        <text class="index-tip">实时空气质量指数</text>
      </view>

      <view class="index-card index-card-icon">
        <image class="card-icon-img" src="/images/weather/wind-compass.svg" mode="aspectFit"></image>
        <text class="index-name">风向风速</text>
        <text class="index-value">{{windDir}}</text>
        <text class="index-tip">{{windLevel}}</text>
      </view>
    </view>
    <!-- 湿度 / 日出日落 -->
    <view class="index-grid metric-grid">
      <view class="index-card humidity-card">
        <view class="humidity-water" style="height: {{humidity}}%;">
          <view class="humidity-wave wave-a"></view>
          <view class="humidity-wave wave-b"></view>
        </view>
        <view class="humidity-content">
          <view class="humidity-left">
            <text class="humidity-title">湿度</text>
            <text class="humidity-value">{{humidity}}%</text>
          </view>
          <view class="humidity-right">
            <view class="humidity-gauge">
              <view class="humidity-arc" style="background: conic-gradient(from 226deg, #3cb4f0 0deg, #3cb4f0 {{gaugeDeg}}deg, rgba(0,0,0,0.10) {{gaugeDeg}}deg, rgba(0,0,0,0.10) 268deg, rgba(0,0,0,0) 268deg);"></view>
              <view class="humidity-hole">
                <image class="humidity-drop" src="/images/icons/humidity.svg" mode="aspectFit"></image>
              </view>
            </view>
            <text class="humidity-gauge-label">{{humidityShort}}</text>
          </view>
        </view>
      </view>

      <view class="index-card sun-card">
        <text class="index-name">日出日落</text>
        <view class="sun-body">
          <view class="sun-side">
            <image class="sun-icon" src="/images/icons/sunrise.svg" mode="aspectFit"></image>
            <text class="sun-time">{{sunrise}}</text>
          </view>
          <view class="sun-divider"></view>
          <view class="sun-side">
            <image class="sun-icon" src="/images/icons/sunset.svg" mode="aspectFit"></image>
            <text class="sun-time">{{sunset}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 24 小时降水：卡片标题行左侧为「降水概率」，中间为近 2 小时临近预报，右侧为峰值 -->
    <view class="section" wx:if="{{rainPoints.length > 0}}">
      <text class="section-title">24小时降水</text>

      <!-- 24 小时降水概率：X 轴为时间 -->
      <view class="rain-card">
        <view class="rain-head">
          <text class="rain-head-title">降水概率</text>

          <!-- 近 2 小时临近预报：与标题同一行、居中 -->
          <view class="rain-now" wx:if="{{rainVisible}}">
            <image class="rain-now-icon" src="/images/weather/rain-light.svg" mode="aspectFit"></image>
            <text class="rain-now-text">{{rainSummary}}</text>
          </view>

          <text class="rain-head-peak">最高 {{rainPeak}}%</text>
        </view>

        <view class="rain-body">
          <!-- Y 轴：百分比刻度随峰值变化 -->
          <view class="rain-yaxis">
            <text
              class="rain-yaxis-label"
              wx:for="{{rainTicks}}"
              wx:key="key"
              style="top: {{item.top}}%;"
            >{{item.label}}%</text>
          </view>

          <view class="rain-plot">
            <view class="rain-chart">
              <view class="rain-col" wx:for="{{rainPoints}}" wx:key="key">
                <view class="rain-col-fill" style="height: {{item.h}}%;"></view>
              </view>
            </view>

            <!-- X 轴：flex 均分，等距分布，首尾贴边 -->
            <view class="rain-axis">
              <text class="rain-axis-label" wx:for="{{rainAxis}}" wx:key="key">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 24 小时 -->
    <view class="section">
      <text class="section-title">24小时预报</text>
      <scroll-view class="hourly" scroll-x show-scrollbar="{{false}}">
        <view class="hour" wx:for="{{hourly}}" wx:key="time">
          <text class="hour-time">{{item.time}}</text>
          <image wx:if="{{item.image}}" class="hour-icon-img" src="{{item.image}}" mode="aspectFit"></image>
          <text wx:else class="qi hour-icon" style="color: {{item.color}};">{{item.glyph}}</text>
          <text class="hour-temp">{{item.temp}}°</text>
        </view>
      </scroll-view>
    </view>

    <!-- 10 天 -->
    <view class="section">
      <text class="section-title">10日预报</text>
      <view class="daily">
        <view class="day" wx:for="{{daily}}" wx:key="date">
          <view class="day-date">
            <text class="day-name">{{item.day}}</text>
            <text class="day-sub">{{item.date}}</text>
          </view>
          <image wx:if="{{item.image}}" class="day-icon-img" src="{{item.image}}" mode="aspectFit"></image>
          <text wx:else class="qi day-icon" style="color: {{item.color}};">{{item.glyph}}</text>
          <text class="day-desc">{{item.desc}}</text>
          <view class="bar">
            <view class="bar-track">
              <view class="bar-range" style="left: {{item.barLeft}}%; width: {{item.barWidth}}%;"></view>
            </view>
          </view>
          <text class="day-temp">{{item.low}}° / {{item.high}}°</text>
        </view>
      </view>
    </view>

    <!-- 天气指数 -->
    <view class="section">
      <text class="section-title">天气指数</text>
      <view class="index-grid">
        <view class="index-card" wx:for="{{indices}}" wx:key="name">
          <view class="index-head">
            <image wx:if="{{item.image}}" class="index-icon-img" src="{{item.image}}" mode="aspectFit"></image>
            <text wx:else class="index-icon">{{item.icon}}</text>
            <text class="index-name">{{item.name}}</text>
          </view>
          <text class="index-value">{{item.value}}</text>
          <text class="index-tip">{{item.tip}}</text>
        </view>
      </view>
    </view>
  </block>

  <text class="data-note">{{notice}}</text>
</view>

<!-- 液态玻璃卡片：每次进入弹一次，点空白处关闭 -->
<view
  wx:if="{{glassVisible}}"
  class="glass-mask"
  bindtap="onGlassClose"
  catchtouchmove="noop"
>
  <view class="glass-card" catchtap="noop">
    <view class="glass-aurora"></view>
    <view class="glass-streak"></view>
    <view class="glass-blob blob-one"></view>
    <view class="glass-blob blob-two"></view>

    <view class="glass-content">
      <view class="glass-loc">
        <image class="glass-loc-icon" src="/images/icons/location.svg" mode="aspectFit"></image>
        <text class="glass-place">{{place}}</text>
      </view>

      <view class="glass-main">
        <text class="glass-temp">{{temp}}°</text>
        <image
          wx:if="{{image}}"
          class="glass-weather-icon"
          src="{{image}}"
          mode="aspectFit"
        ></image>
        <text wx:else class="qi glass-weather-glyph" style="color: {{color}};">{{glyph}}</text>
      </view>

      <view class="glass-desc-row">
        <text class="glass-desc">{{desc}}</text>
        <text class="glass-feel">体感 {{feel}}°</text>
      </view>
      <text class="glass-tip">轻触空白处关闭</text>
    </view>
  </view>
</view>
