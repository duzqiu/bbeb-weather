/**mine.wxss**/
.page {
  min-height: 100vh;
  padding: 32rpx 40rpx;
  background-color: #f5f6f8;
}

/* 单个卡片 */
.card {
  padding: 0 32rpx;
  background-color: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.card-second {
  margin-top: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.row-last {
  border-bottom: none;
}

.label {
  font-size: 29rpx;
  color: rgba(0, 0, 0, 0.85);
}

.value {
  max-width: 460rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: right;
}

.arrow {
  font-size: 34rpx;
  color: rgba(0, 0, 0, 0.25);
}

.row:active {
  background-color: rgba(0, 0, 0, 0.02);
}
