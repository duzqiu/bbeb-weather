/**mine.wxss**/
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 16rpx 32rpx 150rpx;
  padding-bottom: calc(150rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background-color: #f5f6f8;
}

/* 开关行 */
.row-switch {
  transform: scale(0.85);
  transform-origin: right center;
}

/* 行尾：数值 + 箭头 */
.row-tail {
  display: flex;
  align-items: center;
}

.row-tail .value {
  margin-right: 8rpx;
}

/* 单个卡片 */
.card {
  margin-top: 24rpx;
  padding: 0 32rpx;
  background-color: rgba(255, 255, 255, 0.40);
  background-image: linear-gradient(
    140deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.16) 42%,
    rgba(255, 255, 255, 0.08) 62%,
    rgba(255, 255, 255, 0.46) 100%
  );
  -webkit-backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  backdrop-filter: blur(48rpx) saturate(180%) brightness(1.06);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  box-shadow:
    0 10rpx 40rpx rgba(23, 43, 77, 0.12),
    0 1rpx 2rpx rgba(255, 255, 255, 0.65) inset,
    0 -1rpx 2rpx rgba(255, 255, 255, 0.22) inset;
}

/* 页面标题：左上角 */
.page-title {
  display: block;
  margin-top: 8rpx;
  text-align: left;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  color: rgba(0, 0, 0, 0.88);
}



.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.row-last {
  border-bottom: none;
}

/* 意见反馈：整行是普通 view，上面盖一个透明 button 承接 open-type="feedback" */
.row-tap {
  position: relative;
}

.row-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background-color: transparent;
  opacity: 0;
}

.row-hit::after {
  width: 0;
  height: 0;
  border: none;
}

.label {
  font-size: 29rpx;
  color: rgba(0, 0, 0, 0.85);
}

.value {
  max-width: 460rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: right;
}

.arrow {
  font-size: 34rpx;
  color: rgba(0, 0, 0, 0.25);
}

.row:active {
  background-color: rgba(0, 0, 0, 0.02);
}

/* ---------------- 隐私说明弹窗 ---------------- */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(10, 16, 30, 0.42);
}

.modal-card {
  width: 620rpx;
  padding: 40rpx 40rpx 0;
  border-radius: 32rpx;
  background-color: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(12, 24, 48, 0.28);
  animation: modal-pop 240ms cubic-bezier(0.22, 1.1, 0.36, 1) both;
}

.modal-title {
  display: block;
  margin-bottom: 28rpx;
  text-align: center;
  font-size: 33rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

/* 正文整体左对齐 */
.modal-body {
  text-align: left;
}

.modal-h {
  display: block;
  margin-bottom: 8rpx;
  text-align: left;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.88);
}

.modal-p {
  display: block;
  margin-bottom: 26rpx;
  text-align: left;
  font-size: 26rpx;
  line-height: 1.65;
  color: rgba(0, 0, 0, 0.6);
}

.modal-note {
  display: block;
  margin-bottom: 26rpx;
  text-align: left;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(0, 0, 0, 0.35);
}

/* 联系邮箱：可点击复制 */
.modal-mail {
  display: block;
  margin-bottom: 26rpx;
  text-align: left;
  font-size: 26rpx;
  line-height: 1.65;
  color: #07c160;
  text-decoration: underline;
}

.modal-btn {
  margin: 6rpx -40rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #07c160;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.modal-btn:active {
  background-color: rgba(0, 0, 0, 0.03);
}

@keyframes modal-pop {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
